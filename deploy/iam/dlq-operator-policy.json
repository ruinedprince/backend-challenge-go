{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectAndRedriveFailures",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:SendMessage"
      ],
      "Resource": [
        "arn:aws:sqs:<region>:<account-id>:wager-transactions-dlq.fifo",
        "arn:aws:sqs:<region>:<account-id>:wager-transactions.fifo"
      ]
    }
  ]
}
